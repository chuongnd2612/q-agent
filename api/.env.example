# Q-Agent backend configuration. Copy to `.env` and adjust.
# All vars are prefixed QAGENT_.

# Server
QAGENT_HOST=127.0.0.1
QAGENT_PORT=8787

# Database. Defaults to a local SQLite file under workspace_dir when unset.
# Point at PostgreSQL for a shared/production deployment (schema is managed by
# Alembic — see `alembic.ini` / `migrations/`; run `uv run alembic upgrade head`).
# QAGENT_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/qagent

# Secret used to derive the credential-encryption key + sign auth JWTs. CHANGE THIS.
QAGENT_SECRET_KEY=change-me-to-a-long-random-string

# Auth (ADR 0007, #79). ON by default → every route/WS/artifact requires login.
# Set to false to opt back into the local-first single-user mode.
QAGENT_AUTH_REQUIRED=true
# Set the Secure flag on auth cookies. Keep false for http-localhost dev; set true
# behind HTTPS in production. When true, the password-reset token is NOT echoed,
# and the dev fallback admin below is DISABLED (you must set the admin vars).
QAGENT_COOKIE_SECURE=false
# First-admin seed (created when the users table is empty). In dev (COOKIE_SECURE
# false) with auth on, a fallback admin@qagent.local is auto-seeded and its
# generated password logged at startup if these are left blank — so you're never
# locked out. Set them to choose your own; REQUIRED in production.
QAGENT_ADMIN_EMAIL=
QAGENT_ADMIN_PASSWORD=

# EmeHub SSO (#478, docs/HUB-INTEGRATION.md). OFF by default — while disabled the
# whole integration is dormant: hub tokens are REJECTED (not waved through),
# /auth/sso/complete is not registered, and /login shows only the local form.
# This gates a feature, not an auth check (unlike QAGENT_AUTH_REQUIRED above).
QAGENT_HUB_SSO_ENABLED=false
# The hub's API as the BROWSER reaches it — a public origin, carrying the hub's
# /api prefix (e.g. https://hub.chuongnd.click/api). The SPA calls
# /auth/agent-token on it directly, so localhost:8790 will not do.
QAGENT_HUB_BASE_URL=
# The same hub as THIS CONTAINER reaches it. Optional; falls back to the public
# URL above. Worth setting whenever the two run on one host: the public URL is
# ~498ms per call (out to the Cloudflare edge and back to this machine) against
# ~2ms over the bridge, and a workspace sync makes one call per ticket page.
# e.g. http://host.docker.internal:8790  — or http://emehub-api:8790 on a shared
# docker network. The browser can never use this value.
QAGENT_HUB_INTERNAL_BASE_URL=
# Must EQUAL the hub's EMEHUB_JWT_SECRET. Keep it separate from QAGENT_SECRET_KEY
# above — that one signs local JWTs *and* derives the credential-encryption key,
# and overloading it makes the eventual re-key worse (emehub ADR 0005).
QAGENT_HUB_JWT_SECRET=
QAGENT_HUB_AUDIENCE=qagent
# Read hub-OWNED data (tickets, Claude credentials, connections) — #497. Requires
# QAGENT_HUB_SSO_ENABLED too; off means no hub reads happen at all.
QAGENT_HUB_DATA_ENABLED=false

# Claude CLI (must be installed + authenticated: `claude login`)
QAGENT_CLAUDE_BIN=claude
QAGENT_CLAUDE_MODEL=claude-sonnet-5
QAGENT_CLAUDE_TIMEOUT_S=300

# Playwright (invoked via npx in the app/ workspace)
QAGENT_EXEC_TIMEOUT_S=600
