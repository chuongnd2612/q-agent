{
  "name": "@q-agent/playwright-base",
  "version": "1.0.0",
  "description": "Q-Agent Playwright base framework — generic automation infrastructure (fixtures, evidence capture, auth state, API helpers, logging, assertions) shared by every generated automation project, so Q-Agent never regenerates it per feature.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "VERSION"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chuongduong2810/q-agent.git",
    "directory": "playwright-base"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "q-agent"
  ],
  "scripts": {
    "check:version": "node scripts/check-version.mjs",
    "check:runtime": "node scripts/check-runtime-import.mjs",
    "prebuild": "npm run check:version && npm run check:runtime",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vendor": "node scripts/vendor.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
